# Copy to .secrets/tenhabitat.env for repo-scoped local secrets.
# Never commit .secrets/tenhabitat.env or any real token.

# Preferred for CLI and MCP automation. Leave blank only if using the
# repo-isolated Netlify OAuth login flow.
TENHABITAT_NETLIFY_AUTH_TOKEN=
TENHABITAT_NETLIFY_TEAM_ID=
TENHABITAT_NETLIFY_SITE_ID=
