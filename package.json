{
  "name": "tenhabitat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:netlify": "scripts/netlify-tenhabitat.sh dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:e2e": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:e2e:ui": "env -u FORCE_COLOR -u NO_COLOR playwright test --ui",
    "check": "pnpm type-check && pnpm lint && pnpm build",
    "netlify:verify-team": "scripts/netlify-tenhabitat.sh verify-team"
  },
  "dependencies": {
    "@netlify/database": "1.1.0",
    "@radix-ui/react-slot": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@netlify/functions": "5.3.0",
    "@netlify/plugin-nextjs": "5.15.12",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.10",
    "netlify-cli": "26.2.0",
    "postcss": "8.5.16",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  }
}
